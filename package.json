{
    "name": "dom-to-image-more",
    "version": "3.11.0",
    "description": "Generates an image from a DOM node using HTML5 canvas and SVG",
    "main": "dist/dom-to-image-more.min.js",
    "types": "dom-to-image-more.d.ts",
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "chai": "^6.2.2",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "grunt": "^1.6.3",
        "grunt-cli": "^1.5.0",
        "grunt-contrib-jshint": "^3.2.0",
        "grunt-contrib-uglify": "^5.2.2",
        "grunt-contrib-watch": "^1.1.0",
        "grunt-karma": "^4.0.2",
        "js-yaml": "^5.4.2",
        "karma": "^6.4.4",
        "karma-chrome-launcher": "^3.2.0",
        "karma-firefox-launcher": "^2.1.3",
        "karma-mocha": "^2.0.1",
        "karma-mocha-reporter": "^2.2.5",
        "mocha": "^12.0.2",
        "prettier": "^3.9.9",
        "semver": "^7.8.5",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "format": "eslint src --fix && prettier --write .",
        "lint": "eslint --max-warnings=0 src && prettier --check .",
        "test": "node scripts/test.js",
        "test:chrome": "KARMA_BROWSER=chrome node scripts/test.js",
        "test:firefox": "KARMA_BROWSER=firefox node scripts/test.js",
        "test:logic": "LOGIC_ONLY=1 node scripts/test.js",
        "test:logic:firefox": "KARMA_BROWSER=firefox LOGIC_ONLY=1 node scripts/test.js",
        "test:types": "tsc --noEmit --strict --esModuleInterop --lib dom,es2020 test-d/dom-to-image-more.test-d.ts",
        "build": "grunt",
        "build:ci": "grunt ci",
        "beta-version-patch": "npm version $(semver $npm_package_version -i prerelease --preid beta)",
        "beta-version-minor": "npm version $(semver $npm_package_version -i preminor --preid beta)",
        "beta-version-major": "npm version $(semver $npm_package_version -i premajor --preid beta)",
        "rc-version": "npm version $(semver $npm_package_version -i prerelease --preid rc)",
        "final-release": "npm version $(semver $npm_package_version -i)",
        "postversion": "npm run test && git push && git push --tags"
    },
    "repository": "github:IDisposable/dom-to-image-more",
    "keywords": [
        "dom",
        "image",
        "raster",
        "render",
        "html",
        "canvas",
        "svg",
        "png"
    ],
    "author": "Marc Brooks <idisposable@gmail.com> (https://about.me/IDisposable)",
